{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchbay",
  "version": "2.0.0",
  "identifier": "io.patchbay.studio",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Patchbay — Mealy & Moore machines",
        "width": 1440,
        "height": 1000,
        "minWidth": 640,
        "minHeight": 480,
        "create": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#0C0D0D",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "An offline Mealy and Moore machine studio",
    "copyright": "Copyright (c) 2026 Patchbay",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../public/licenses/Inter-OFL.txt": "licenses/Inter-OFL.txt",
      "../public/licenses/IBM-Plex-OFL.txt": "licenses/IBM-Plex-OFL.txt",
      "../public/licenses/Newsreader-OFL.txt": "licenses/Newsreader-OFL.txt",
      "../LICENSE": "PATCHBAY-LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "Patchbay",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
