{
  "name": "patchbay",
  "productName": "Patchbay",
  "version": "1.3.0",
  "private": true,
  "description": "A tactile Mealy and Moore machine workbench",
  "author": "Patchbay",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:ui": "node tests/ui.mjs",
    "test:graph": "node tests/graphical-editor.mjs",
    "test:scale": "node tests/scalability.mjs",
    "test:motion": "node tests/motion-theme.mjs",
    "test:depth": "node tests/depth-scene.mjs",
    "dist:windows": "npm run build && node scripts/distribute.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
