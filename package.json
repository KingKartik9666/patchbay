{
  "name": "patchbay",
  "productName": "Patchbay",
  "version": "2.0.0",
  "private": true,
  "description": "An offline Mealy and Moore machine workbench",
  "author": "Patchbay",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "npm@11.12.0",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev -- --locked",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "tauri": "node scripts/tauri.mjs",
    "desktop:debug": "node scripts/tauri.mjs build --debug --no-bundle -- --locked",
    "desktop:build": "node scripts/tauri.mjs build --no-bundle -- --locked",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:rust": "node scripts/cargo.mjs test --workspace --locked",
    "test:core": "node scripts/cargo.mjs test -p patchbay-core --locked",
    "test:ui": "node tests/native-ui.mjs",
    "test:appearance": "node tests/native-appearance.mjs",
    "test:session": "node tests/native-session.mjs",
    "test:graph": "node tests/frontend/graph-editor-browser.mjs",
    "test:renderers": "node tests/react-renderers.mjs",
    "test:browser": "npm run test:graph && npm run test:renderers",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:package": "node scripts/check-package.mjs",
    "licenses": "node scripts/licenses.mjs",
    "dist:windows": "node scripts/distribute.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "oxc-transform-react": "0.152.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
